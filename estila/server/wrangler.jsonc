// Servidor do Estila. Segredo da IA: `npx wrangler secret put ANTHROPIC_API_KEY` (nunca no código).
// Sem o segredo, o servidor responde em modo demonstração (sem custo).
{
  "name": "estila-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "MODELO": "claude-opus-5-5",
    "ORIGENS": "http://localhost:8081"
  },
  // Até 10 análises por minuto por IP.
  "ratelimits": [{ "name": "LIMITE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }]
}
